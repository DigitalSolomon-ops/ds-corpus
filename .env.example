# Local development only. In production, secrets come from Secret Manager
# via the Cloud Run Job's service identity — never from env files.
# Copy to .env and fill in. .env is gitignored.

# Free public API keys/tokens (P4+). Nothing beyond these is ever required.
COURTLISTENER_TOKEN=
GOVINFO_KEY=
SMITHSONIAN_KEY=
ANTHROPIC_API_KEY=
